{
    "name": "deathpaul1125/laravel-doctor",
    "description": "Static analysis tool for Laravel projects: detects security, performance, architecture and dead-code issues with a health score.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "static-analysis", "code-quality", "security", "eloquent", "doctor"],
    "require": {
        "php": "^8.1",
        "symfony/console": "^6.0 || ^7.0",
        "symfony/finder": "^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelDoctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelDoctor\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/laravel-doctor"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "LaravelDoctor\\Laravel\\DoctorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
